        "900": "#1e2619"
      },
      "cyan": {
        "100": "#e8f5f3",
        "200": "#c6e6e2",
        "300": "#a0d6ce",
        "400": "#81c8be",
        "500": "#6eaaa2",
        "600": "#588881",
        "700": "#40645f",
        "800": "#29403d",
        "900": "#172422"
      },
      "blue": {
        "100": "#eaf0fc",
        "200": "#cbd9f7",
