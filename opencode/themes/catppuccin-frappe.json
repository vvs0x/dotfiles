{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["accent", "purple", "green", "orange", "red", "cyan"],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$hue.blue.300",
          "$hovered": "$hue.blue.200",
          "$focused": "$hue.blue.200",
          "$pressed": "$hue.blue.100",
          "$selected": "$hue.blue.200",
          "$disabled": "$hue.neutral.600"
        },
        "secondary": {
          "base": "$hue.neutral.200",
          "$hovered": "$hue.neutral.100",
          "$focused": "$hue.neutral.100",
          "$pressed": "$hue.neutral.100",
          "$selected": "$hue.neutral.100",
          "$disabled": "$hue.neutral.600"
        },
        "destructive": {
          "base": "$hue.red.300",
          "$hovered": "$hue.red.200",
          "$focused": "$hue.red.200",
          "$pressed": "$hue.red.100",
          "$selected": "$hue.red.200",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.neutral.100",
        "$focused": "$hue.neutral.100",
        "$pressed": "$hue.neutral.100",
        "$selected": "$hue.neutral.100",
        "$disabled": "$hue.neutral.600"
      },
      "feedback": {
        "error": { "base": "$hue.red.300", "muted": "$hue.red.400" },
        "warning": { "base": "$hue.yellow.300", "muted": "$hue.yellow.400" },
        "success": { "base": "$hue.green.300", "muted": "$hue.green.400" },
        "info": { "base": "$hue.blue.300", "muted": "$hue.blue.400" }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      },
      "action": {
        "primary": {
          "base": "$hue.blue.400",
          "$hovered": "$hue.blue.300",
          "$focused": "$hue.blue.300",
          "$pressed": "$hue.blue.500",
          "$selected": "$hue.blue.300",
          "$disabled": "$hue.neutral.700"
        },
        "secondary": {
          "base": "$hue.neutral.700",
          "$hovered": "$hue.neutral.600",
          "$focused": "$hue.neutral.600",
          "$pressed": "$hue.neutral.800",
          "$selected": "$hue.neutral.600",
          "$disabled": "$hue.neutral.800"
        },
        "destructive": {
          "base": "$hue.red.400",
          "$hovered": "$hue.red.300",
          "$focused": "$hue.red.300",
          "$pressed": "$hue.red.500",
          "$selected": "$hue.red.300",
          "$disabled": "$hue.neutral.700"
        }
      },
      "formfield": {
        "base": "$hue.neutral.800",
        "$hovered": "$hue.neutral.700",
        "$focused": "$hue.neutral.700",
        "$pressed": "$hue.neutral.900",
        "$selected": "$hue.neutral.700",
        "$disabled": "$hue.neutral.900"
      },
      "feedback": {
        "error": { "base": "$hue.red.800" },
        "warning": { "base": "$hue.yellow.800" },
        "success": { "base": "$hue.green.800" },
        "info": { "base": "$hue.blue.800" }
      }
    },
    "border": {
      "base": "$hue.neutral.700"
    },
    "scrollbar": {
      "base": "$hue.neutral.700"
    },
    "diff": {
      "text": {
        "added": "$hue.green.300",
        "removed": "$hue.red.300",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.blue.200"
      },
      "background": {
        "added": "$hue.green.800",
        "removed": "$hue.red.800",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "$hue.green.700",
        "removed": "$hue.red.700"
      },
      "lineNumber": {
        "text": "$hue.neutral.500",
        "background": {
          "added": "$hue.green.800",
          "removed": "$hue.red.800"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.500",
      "keyword": "$hue.purple.300",
      "function": "$hue.blue.300",
      "variable": "$hue.neutral.100",
      "string": "$hue.green.300",
      "number": "$hue.orange.300",
      "type": "$hue.yellow.300",
      "operator": "$hue.cyan.300",
      "punctuation": "$hue.neutral.400"
    },
    "markdown": {
      "text": "$hue.neutral.100",
      "heading": "$hue.blue.200",
      "link": "$hue.blue.300",
      "linkText": "$hue.blue.200",
      "code": "$hue.cyan.300",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.orange.300",
      "strong": "$hue.yellow.300",
      "horizontalRule": "$hue.neutral.700",
      "listItem": "$hue.neutral.100",
      "listEnumeration": "$hue.blue.300",
      "image": "$hue.cyan.300",
      "imageText": "$hue.neutral.400",
      "codeBlock": "$hue.cyan.300"
    }
  },
